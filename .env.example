# ── LLM ──────────────────────────────────────────────────────────────
OPENROUTER_API_KEY=sk-or-v1-PASTE_YOUR_KEY_HERE
OPENROUTER_BASE_URL=https://openrouter.ai/api/v1
# Must be a vision-capable model (agents process PDF/PPTX pages as images).
# DeepSeek V3/V4 Pro are text-only — do NOT use them here.
OPENROUTER_MODEL=deepseek/deepseek-v4.1-flash

# ── Database (PostgreSQL) ────────────────────────────────────────────
DATABASE_URL=postgresql+asyncpg://postgres:postgres@localhost:5433/harbour

# ── Backend ──────────────────────────────────────────────────────────
BACKEND_HOST=127.0.0.1
BACKEND_PORT=8000
